# Organizational Units
dn: ou=people,dc=comet,dc=example
objectClass: organizationalUnit
ou: people

dn: ou=groups,dc=comet,dc=example
objectClass: organizationalUnit
ou: groups

# User: alice (member of engineering)
dn: uid=alice,ou=people,dc=comet,dc=example
objectClass: inetOrgPerson
objectClass: posixAccount
objectClass: shadowAccount
uid: alice
sn: Engineer
givenName: Alice
cn: Alice Engineer
displayName: Alice Engineer
uidNumber: 10000
gidNumber: 10000
userPassword: changeme
loginShell: /bin/bash
homeDirectory: /home/alice
mail: alice@comet.example

# User: bob (member of engineering)
dn: uid=bob,ou=people,dc=comet,dc=example
objectClass: inetOrgPerson
objectClass: posixAccount
objectClass: shadowAccount
uid: bob
sn: Engineer
givenName: Bob
cn: Bob Engineer
displayName: Bob Engineer
uidNumber: 10001
gidNumber: 10001
userPassword: changeme
loginShell: /bin/bash
homeDirectory: /home/bob
mail: bob@comet.example

# User: chris (member of engineering)
dn: uid=chris,ou=people,dc=comet,dc=example
objectClass: inetOrgPerson
objectClass: posixAccount
objectClass: shadowAccount
uid: chris
sn: Engineer
givenName: Chris
cn: Chris Engineer
displayName: Chris Engineer
uidNumber: 10002
gidNumber: 10002
userPassword: changeme
loginShell: /bin/bash
homeDirectory: /home/chris
mail: chris@comet.example

# Group: team-a
dn: cn=team-a,ou=groups,dc=comet,dc=example
objectClass: groupOfNames
cn: team-a
member: uid=alice,ou=people,dc=comet,dc=example
member: uid=chris,ou=people,dc=comet,dc=example

# Group: team-b
dn: cn=team-b,ou=groups,dc=comet,dc=example
objectClass: groupOfNames
cn: team-b
member: uid=bob,ou=people,dc=comet,dc=example
member: uid=chris,ou=people,dc=comet,dc=example
